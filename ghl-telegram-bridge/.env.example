# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and must NEVER be committed.

# From BotFather: /mybots -> your bot -> API Token
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# The chat/group to post into. Run "npm run chat-id" to discover it.
# Group IDs are usually negative, e.g. -1001234567890
TELEGRAM_CHAT_ID=-1001234567890

# Port the bridge listens on (default 3000).
PORT=3000

# Optional: a shared secret so only your GHL webhook can post.
# If set, GHL must call the URL with ?key=THIS_VALUE (or header X-Webhook-Secret).
WEBHOOK_SECRET=
